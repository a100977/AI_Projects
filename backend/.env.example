# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# API Keys & Credentials (fill in your actual values)
# =====================================================

# Airtable
AIRTABLE_API_KEY=your_airtable_api_key_here

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/document_merge

# MySQL
MYSQL_URL=mysql://user:password@localhost:3306/document_merge

# MongoDB
MONGODB_URI=mongodb://localhost:27017/document_merge

# REST API (example)
EXTERNAL_API_BASE_URL=https://api.example.com/v1
EXTERNAL_API_KEY=your_api_key_here

# Salesforce
SALESFORCE_INSTANCE_URL=https://mycompany.salesforce.com
SALESFORCE_CLIENT_ID=your_client_id
SALESFORCE_CLIENT_SECRET=your_client_secret
SALESFORCE_USERNAME=your_username
SALESFORCE_PASSWORD=your_password

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# AWS S3 (for batch processing output)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your-bucket-name

# Email (optional, for notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
NOTIFICATION_EMAIL=support@document-merge.dev

# JWT/Security
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRATION=7d

# Feature Flags
ENABLE_BATCH_PROCESSING=true
ENABLE_S3_OUTPUT=true
ENABLE_WEBHOOKS=false
ENABLE_RATE_LIMITING=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE=10000

# Logging
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log

# Database (audit logging)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DATABASE_URL=postgresql://user:password@localhost:5432/audit_logs

# Notes
# =====
# 1. For local development, you can use mock/test values
# 2. Never commit actual credentials to git
# 3. Use environment variables for production
# 4. Test connections after setting values
# 5. See DATA_SOURCES.md for detailed configuration guides
