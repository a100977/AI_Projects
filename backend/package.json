{
  "name": "document-merge-backend",
  "version": "0.1.0",
  "description": "Document Merge backend server - Node.js/Express/TypeScript",
  "author": "Amit Gupta <a1009us@gmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",

  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },

  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "docx": "^8.5.0",
    "pdfkit": "^0.13.0",
    "xlsx": "^0.18.5",
    "pg": "^8.11.0",
    "mysql2": "^3.6.0",
    "mongodb": "^5.9.0",
    "airtable": "^2.1.0",
    "graphql-request": "^6.0.0",
    "jsforce": "^2.0.0",
    "google-spreadsheet": "^4.1.2",
    "csv-parser": "^3.0.0",
    "fuse.js": "^7.0.0",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.0",
    "uuid": "^9.0.1"
  },

  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.10",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.0"
  },

  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },

  "keywords": [
    "document-merge",
    "variable-mapping",
    "finance",
    "legal",
    "template",
    "airtable",
    "database",
    "api",
    "batch-processing"
  ]
}
